#!/usr/bin/env bash

# https://mise.jdx.dev - erlang, elixir, ruby, scala, sbt, scala-cli, terraform, opam, zig, crystal
export KERL_CONFIGURE_OPTIONS="\
    --without-javac \
    --without-wx"

# Never let mise create a uv venv itself. It runs `uv venv` without --python, uv
# finds python3.14 on PATH as a mise shim, the shim re-enters mise, which runs
# `uv venv` again: unbounded uv/python chain, OOM (archibot worktrees, no .venv).
# The env var beats project mise.toml settings; `uv sync` still creates the venv.
export MISE_PYTHON_UV_VENV_AUTO=source

command -v mise >/dev/null 2>&1 || return 0
if [ -n "$PS1" ]; then
    eval "$(mise activate bash)"
else
    export PATH="$HOME/.local/share/mise/shims:$PATH"
fi
