#!/bin/bash

cd "$(dirname "$(readlink -f "$0")")" || exit 1

BIN_NAME="$(basename "$0")"
COMMAND_NAME=$1

sub_help () {
    echo "Usage: $BIN_NAME <command>"
    echo
    echo "Commands:"
    echo "   help               This help message"
    echo "   reload             Reload ~/.bashrc"
    echo "   system             Install basic setup for Kubuntu"
    echo "   pro                Install programming environments"
    echo "   ai                 Install AI coding tools (Claude Code, Codex, OpenCode) and desktop apps"
    echo "   shell              Install shell tools and link dotfiles into \$HOME"
    echo "   sublime            Install Sublime Text (official apt repo, dev channel)"
    echo "   emacs              Install Emacs and Spacemacs"
    echo "   vim                Install Vim and link .vimrc"
    echo "   vscode             Install VSCode and VSCode Insiders (Microsoft apt repo)"
    echo "   zed                Install Zed editor"
    echo "   all                Run every install step"
}

sub_reload () {
    # shellcheck disable=SC1091
    source "$HOME/.bashrc" && echo "Bash reloaded."
}

sub_system ()  { bash install/system-install.bash; }
sub_pro ()     { bash install/pro-install.bash; }
sub_ai ()      { bash install/ai-install.bash; }
sub_shell ()   { bash install/shell-install.bash; }
sub_sublime () { bash install/sublime-install.bash; }
sub_vim ()     { bash install/vim-install.bash; }
sub_emacs ()   { bash install/emacs-install.bash; }
sub_vscode ()  { bash install/vscode-install.bash; }
sub_zed ()     { bash install/zed-install.bash; }

sub_all () {
    sub_system
    sub_pro
    sub_ai
    sub_sublime
    sub_vim
    sub_emacs
    sub_vscode
    sub_zed
    sub_shell
}

case $COMMAND_NAME in
    "" | "-h" | "--help" | "help")
        sub_help
        ;;
    *)
        shift
        if declare -F "sub_$COMMAND_NAME" >/dev/null; then
            "sub_$COMMAND_NAME" "$@"
        else
            echo "'$COMMAND_NAME' is not a known command." >&2
            sub_help
            exit 1
        fi
        ;;
esac
